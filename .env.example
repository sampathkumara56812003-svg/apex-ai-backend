NODE_ENV=development
PORT=5000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=apex_ai

JWT_ACCESS_SECRET=dev_access_secret_replace_me_with_random_64_chars_min
JWT_REFRESH_SECRET=dev_refresh_secret_replace_me_with_random_64_chars_min
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

BINANCE_SPOT_BASE=https://data-api.binance.vision
BINANCE_FUTURES_BASE=https://fapi.binance.com
BINANCE_WS_BASE=wss://data-stream.binance.vision
BINANCE_WS_ENABLED=true

MODEL_VERSION=v1.4.2-ensemble
TAKER_FEE_BPS=5
SLIPPAGE_BPS=3
RISK_PER_TRADE_PCT=1.0
INITIAL_PAPER_BALANCE=10000

SCAN_INTERVAL_MS=90000
RESOLVE_INTERVAL_MS=45000
PAPER_SETTLE_INTERVAL_MS=30000
PERFORMANCE_INTERVAL_MS=300000

LOG_LEVEL=debug